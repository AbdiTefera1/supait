# Ignore operating system files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Ignore log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore dependency directories
node_modules/
jspm_packages/
.next/

# Ignore build output
dist/
build/
coverage/

# Ignore environment files
.env
.env.local
.env.*.local
.env.example

# Ignore editor and IDE files
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Ignore package lock files if not committed
package-lock.json
pnpm-lock.yaml
yarn.lock

# Ignore Python cache files
__pycache__/
*.py[cod]
*$py.class

# Ignore temporary files
*.tmp
*.temp
*.swp
*.swo
